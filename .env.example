# CoverPay — copy to .env and adjust. Never commit .env.

# --- Data ---
# IEEE-CIS CSVs (1.35GB, git-ignored). Relative to repo root; absolute also works.
DATA_DIR=ieee-fraud-detection

# --- Database ---
# SQLite for the MVP. Swap for Postgres in Phase 7 when the simulator writes concurrently:
# DATABASE_URL=postgresql+psycopg://coverpay:coverpay@localhost:5432/coverpay
DATABASE_URL=sqlite:///./coverpay.db

# --- Model ---
MODEL_PATH=models/fraud_xgb.json
MODEL_VERSION=v1

# --- Advisory policy (thresholds are policy, not model logic) ---
# score < REVIEW -> ALLOW,  REVIEW <= score < BLOCK -> REVIEW,  >= BLOCK -> BLOCK
RISK_REVIEW_THRESHOLD=0.30
RISK_BLOCK_THRESHOLD=0.70

# --- Cost model (turns the confusion matrix into rupees) ---
# Assumptions, not measurements. `python -m ml.train` sweeps the threshold grid
# against these and reports the cost-optimal pair in docs/metrics.md.
CHARGEBACK_FEE=750       # admin cost of a chargeback, on top of the lost amount
REVIEW_COST=40           # analyst cost to clear one flagged transaction
BLOCK_FRICTION_RATE=0.25 # share of a wrongly BLOCKed legit amount that walks away

# --- Reproducibility ---
RANDOM_SEED=42

# --- API access control ---
# Optional. Unset -> the API is open (fine for local dev). Set it for any
# deployment and every scoring / assistant / CSV endpoint then requires the
# `X-API-Key: <value>` header.
# API_KEY=
# Fixed-window request cap (per key, or per client host) for the assistant and
# CSV-upload endpoints.
# RATE_LIMIT_PER_MINUTE=30

# --- AI Merchant Helper (Phase 14) ---
# Only needed for the assistant. Everything else runs without it.
# GEMINI_API_KEY=your-key-here


# Model the assistant uses. gemini-flash-latest works on a free-tier key;
# the pro models need paid quota. Override once your account has it.
# GEMINI_MODEL=gemini-3.1-pro-preview
