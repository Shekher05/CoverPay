# CoverPay — copy to .env and adjust. Never commit .env.

# --- Data ---
# IEEE-CIS CSVs (1.35GB, git-ignored). Relative to repo root; absolute also works.
DATA_DIR=ieee-fraud-detection

# --- Database ---
# SQLite for local dev. On Render, set DATABASE_URL to the PostgreSQL add-on's
# connection string - `postgres://` and `postgresql://` are both accepted
# (config.py normalises the old scheme).
DATABASE_URL=sqlite:///./coverpay.db

# --- Deployment ---
# Set ENVIRONMENT=production on Render to turn off /docs, /redoc and /openapi.json.
# ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API. On Render set this to
# the Static Site URL. Only needed when the frontend calls the API cross-origin.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model ---
MODEL_PATH=models/fraud_xgb.json
MODEL_VERSION=v1

# --- Advisory policy (thresholds are policy, not model logic) ---
# score < REVIEW -> ALLOW,  REVIEW <= score < BLOCK -> REVIEW,  >= BLOCK -> BLOCK
RISK_REVIEW_THRESHOLD=0.30
RISK_BLOCK_THRESHOLD=0.70

# --- Cost model (turns the confusion matrix into rupees) ---
# Assumptions, not measurements. `python -m ml.train` sweeps the threshold grid
# against these and reports the cost-optimal pair in docs/metrics.md.
CHARGEBACK_FEE=750       # admin cost of a chargeback, on top of the lost amount
REVIEW_COST=40           # analyst cost to clear one flagged transaction
BLOCK_FRICTION_RATE=0.25 # share of a wrongly BLOCKed legit amount that walks away

# --- Reproducibility ---
RANDOM_SEED=42

# --- API access control ---
# Optional. Unset -> the API is open (fine for local dev). Set it for any
# deployment and every scoring / assistant / CSV endpoint then requires the
# `X-API-Key: <value>` header.
# API_KEY=
# Fixed-window request cap (per key, or per client host) for the assistant and
# CSV-upload endpoints.
# RATE_LIMIT_PER_MINUTE=30

# --- AI Merchant Helper (Phase 14) ---
# Only needed for the assistant. Everything else runs without it; without a key
# the assistant returns HTTP 503 with a clear message rather than inventing one.
# OpenRouter is OpenAI-compatible. Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Model + endpoint. Defaults live in config.py; override here if needed.
# minimax/minimax-m3:free is free with a per-day cap (50/day, or 1000/day once
# you have topped up $10 on OpenRouter).
# OPENROUTER_MODEL=minimax/minimax-m3:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
