# CoverPay — copy to .env and adjust. Never commit .env.

# --- Data ---
# IEEE-CIS CSVs (1.35GB, git-ignored). Relative to repo root; absolute also works.
DATA_DIR=ieee-fraud-detection

# --- Database ---
# SQLite for the MVP. Swap for Postgres in Phase 7 when the simulator writes concurrently:
# DATABASE_URL=postgresql+psycopg://coverpay:coverpay@localhost:5432/coverpay
DATABASE_URL=sqlite:///./coverpay.db

# --- Model ---
MODEL_PATH=models/fraud_xgb.json
MODEL_VERSION=v1

# --- Advisory policy (thresholds are policy, not model logic) ---
# score < REVIEW -> ALLOW,  REVIEW <= score < BLOCK -> REVIEW,  >= BLOCK -> BLOCK
RISK_REVIEW_THRESHOLD=0.30
RISK_BLOCK_THRESHOLD=0.70

# --- Reproducibility ---
RANDOM_SEED=42
