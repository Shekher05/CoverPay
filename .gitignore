# Data — IEEE-CIS is ~1.35GB, never commit it
data/
*.csv
*.parquet
*.zip

# Model artifacts. `models/*` (not `models/`) so the two files below can be
# re-included - git will not descend into a fully-ignored directory.
models/*
*.pkl
*.joblib
*.json.model
# The two artifacts the API needs at runtime are committed so a git-based deploy
# (Render) serves without a training run. ~9 MB total.
!models/fraud_xgb.json
!models/feature_spec.json

